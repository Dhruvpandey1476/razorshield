# Copy to .env and fill in what you're using (or export these directly).
# None of these are required for the app to run -- every LLM-dependent
# node falls back to a deterministic template/heuristic with no key,
# and the Razorpay webhook endpoint returns a clear 501 (not a crash)
# if RAZORPAY_WEBHOOK_SECRET is unset.

# --- LLM provider (optional -- pick at most one, or set neither) ---
# OpenRouter (many providers/models behind one key). Checked first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI direct:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Razorpay webhook integration (optional) ---
# Set this to the SAME secret you configure in your Razorpay Dashboard
# under Settings -> Webhooks -> Add New Webhook. Without this set,
# POST /webhooks/razorpay returns 501 rather than accepting
# unverifiable requests.
RAZORPAY_WEBHOOK_SECRET=
